//- ============ СПІЛЬНІ МІКСІНИ ============

//- Міксін 1: SVG-іконки (стиль Lucide), колір береться з currentColor
mixin icon(name, size)
  - var s = size || 18
  svg.icon(width=s height=s viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")&attributes(attributes)
    case name
      when 'grid'
        rect(x="3" y="3" width="7" height="7" rx="1")
        rect(x="14" y="3" width="7" height="7" rx="1")
        rect(x="14" y="14" width="7" height="7" rx="1")
        rect(x="3" y="14" width="7" height="7" rx="1")
      when 'folders'
        path(d="M20 17a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3.9a2 2 0 0 1-1.69-.9l-.81-1.2a2 2 0 0 0-1.67-.9H8a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2Z")
        path(d="M2 8v11a2 2 0 0 0 2 2h14")
      when 'edit'
        path(d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7")
        path(d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z")
      when 'trends'
        path(d="M12 16v5")
        path(d="M16 14v7")
        path(d="M20 10v11")
        path(d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15")
        path(d="M4 18v3")
        path(d="M8 14v7")
      when 'segments'
        path(d="M3 3v16a2 2 0 0 0 2 2h16")
        path(d="M18 17V9")
        path(d="M13 17V5")
        path(d="M8 17v-3")
      when 'sort'
        path(d="M3 6h18")
        path(d="M7 12h10")
        path(d="M10 18h4")
      when 'report'
        path(d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z")
        path(d="M14 2v4a2 2 0 0 0 2 2h4")
        path(d="M10 9H8")
        path(d="M16 13H8")
        path(d="M16 17H8")
      when 'globe'
