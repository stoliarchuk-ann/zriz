        path(d="m7 9 5-5 5 5")
      when 'chevron-down'
        path(d="m6 9 6 6 6-6")
      when 'plus'
        path(d="M5 12h14")
        path(d="M12 5v14")
      when 'download'
        path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4")
        path(d="m7 10 5 5 5-5")
        path(d="M12 15V3")
      when 'trending-up'
        path(d="M16 7h6v6")
        path(d="m22 7-8.5 8.5-5-5L2 17")
      when 'scan'
        path(d="M3 7V5a2 2 0 0 1 2-2h2")
        path(d="M17 3h2a2 2 0 0 1 2 2v2")
