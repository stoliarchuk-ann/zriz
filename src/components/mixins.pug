//- Міксін 2: пункт меню (активний пункт підсвічується)
mixin menu-item(label, iconName, active, href)
  a.menu-item(href=href || '#' class=active ? 'active' : '')
    +icon(iconName, 20)
    span= label

//- Міксін 3: картка статистики
mixin stat-card(item)
  .stat-card
    .card-header
      h3= item.title
      +icon('arrow-up-right', 20).arrow
    .value-row
      .value= item.value
      .badge
        if item.up
          +icon('arrow-up', 14)
        span= item.badge
    p.desc= item.desc

//- Міксін 4: лінійний графік з областю під основною лінією
//- curr, prev — масиви значень; max — верх осі Y; yLabels / xLabels — підписи осей
mixin area-chart(curr, prev, max, yLabels, xLabels)
  - var W = 1000, H = 200, steps = yLabels.length - 1
  - var pts = function (arr) { return arr.map(function (v, i) { return (i * W / (arr.length - 1)).toFixed(1) + ',' + (H - v / max * H).toFixed(1) }).join(' ') }
  .chart-body
    .y-axis
      each label in yLabels
        span= label
    .plot
      svg.chart-svg(viewBox=`0 0 ${W} ${H}` preserveAspectRatio="none" aria-hidden="true")
        defs
          linearGradient#area-grad(gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2=H)
            stop(offset="0" stop-color="#E55B7B" stop-opacity="0.19")
            stop(offset="1" stop-color="#E55B7B" stop-opacity="0")
        - for (var i = 0; i <= steps; i++)
          line.grid-line(x1="0" x2=W y1=(i * H / steps) y2=(i * H / steps))
        polygon.area(points=pts(curr) + ` ${W},${H} 0,${H}` fill="url(#area-grad)")
        polyline.line.line-prev(points=pts(prev))
        polyline.line.line-curr(points=pts(curr))
  .x-axis
    each label in xLabels
      span= label

//- Міксін 5: випадаючий список (логіка — у src/dropdown.js)
//- options — масив рядків; selected — вибраний пункт; btnClass — клас кнопки
mixin dropdown(options, selected, btnClass)
  - var current = selected || options[0]
  .dropdown(data-dropdown)
    button(type="button" class=btnClass || 'select-btn' aria-haspopup="listbox" aria-expanded="false")
      span.dropdown-label= current
      +icon('chevron-down', 18)
    ul.dropdown-menu(role="listbox" hidden)
      each o in options
        li(role="option" tabindex="-1" data-value=o class=o === current ? 'selected' : '')= o
